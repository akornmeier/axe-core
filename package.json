{
  "name": "propellr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.portable.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.host.json && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:contracts": "vitest run --project contracts",
    "test:host": "pnpm build && vitest run --project host",
    "test:playbooks": "vitest run --project playbooks",
    "validate": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:contracts && pnpm test:host && pnpm test:playbooks"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@vitest/browser-playwright": "5.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "26.8.2",
    "pnpm": "12.4.1"
  },
  "packageManager": "pnpm@12.4.1"
}
