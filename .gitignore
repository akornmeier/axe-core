# defaults
node_modules
logs/
.claude/
npm-shrinkwrap.json
.DS_Store
.idea
.turbo/

# tmp - `dev` time generated assets
tmp

# pnpm-lock.yaml is NOT ignored (it should be committed)

# test - runner generated assets
packages/axe-core/test/*/index.html
packages/axe-core/test/integration/*/index.html
!packages/axe-core/test/integration/virtual-rules/index.html

# dist
packages/axe-core/axe.js
packages/axe-core/axe.*.js

# generated src file
packages/axe-core/lib/core/base/metadata-function-map.js

# generated jsdoc api docs
packages/axe-core/doc/api/*
packages/axe-core/doc/examples/*/package-lock.json

# ts generated file
packages/axe-core/typings/axe-core/axe-core-tests.js

# doc
packages/axe-core/doc/rule-descriptions.*.md

# stub package dist
packages/*/dist/

# Build caches must not suppress fresh declaration emission
*.tsbuildinfo
