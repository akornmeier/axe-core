{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["lib/**", "src/**", "tsconfig.json", "vite.config.ts"]
    },
    "build:locales": {
      "dependsOn": ["build"],
      "outputs": ["dist/locales/**"],
      "inputs": ["locales/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["lib/**", "src/**", "tsconfig.json"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["lib/**", "test/**"]
    },
    "test:tsc": {
      "inputs": ["typings/**", "axe.d.ts", "tsconfig.json"]
    },
    "lint": {
      "inputs": ["lib/**", "test/**", "src/**", "../../oxlint.json"]
    },
    "format:check": {
      "inputs": ["**/*.{md,json,ts,html,js,mjs}"]
    },
    "format:fix": {
      "cache": false
    }
  }
}
