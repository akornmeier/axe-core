{
  "name": "@axe-core/build-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Internal Vite build plugins for axe-core",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "echo 'No build configured yet'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate-definitions": "tsx src/validate-definitions.ts",
    "codemod:migrate": "tsx src/codemods/migrate-mocha-to-vitest.ts"
  },
  "dependencies": {
    "@deque/dot": "^1.1.5",
    "aria-query": "^5.3.2",
    "glob": "^10.3.10",
    "html-entities": "^2.4.0",
    "prettier": "^3.0.0",
    "ts-morph": "^25.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "vite": ">=5.0.0 || >=6.0.0 || >=7.0.0",
    "rolldown-vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "rolldown-vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^4"
  },
  "license": "MPL-2.0"
}
