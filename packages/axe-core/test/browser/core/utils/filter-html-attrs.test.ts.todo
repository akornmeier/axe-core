// FIXME(phase-3-sprint-4b): codemod-output failed vitest — see Sprint 4b for residual blockers (likely Path-B Task #4 helper signature mismatch or test-side type/runtime delta).
describe('axe.utils.filterHtmlAttrs', function () {
  var fixture = document.querySelector('#fixture');

  var filterHtmlAttrs = axe.utils.filterHtmlAttrs;
  var html, expected;

  beforeEach(function () {
    fixture.innerHTML =
      '<label> My Label <input type="text" value="my value" /></label>';
    html = fixture.firstChild;
    expected = '<label> My Label <input value="my value"></label>';
  });

  it('should return string if no attributes are passed', function () {
    expect(filterHtmlAttrs(html)).toBe(html);
  });

  it('should filter attribute if exists', function () {
    expect(filterHtmlAttrs(html, { type: true }).outerHTML).toBe(expected);
  });

  it('should filter attribute if matches CSS selector', function () {
    expect(filterHtmlAttrs(html, { type: 'input' }).outerHTML).toBe(expected);
  });

  it('should not filter attribute if does not match value', function () {
    expect(filterHtmlAttrs(html, { type: 'div' }).outerHTML).toBe(html.outerHTML);
  });

  it('should not change the original element', function () {
    var outerHTML = html.outerHTML;
    expect(filterHtmlAttrs(html, { type: true }) !== html).toBe(true);
    expect(html.outerHTML).toBe(outerHTML);
  });

  it('should filter multiple attributes', function () {
    expect(filterHtmlAttrs(html, {
        type: true,
        value: '[value="my value"]'
      }).outerHTML).toBe('<label> My Label <input></label>');
  });
});
