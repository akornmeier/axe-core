// FIXME(phase-3-sprint-4b): codemod blocker — uses axe._audit (internal state); uses chai-style 'assert.*' (codemod did not convert)
describe('axe.utils.finalizeRuleResult', function () {
  var original = axe._audit;

  beforeEach(function () {
    axe._audit = {
      rules: []
    };
  });

  afterAll(function () {
    axe._audit = original;
  });

  it('should be a function', function () {
    assert.isFunction(axe.utils.finalizeRuleResult);
  });

  it('returns the first param object', function () {
    var goingIn = {
      nodes: []
    };
    var comingOut = axe.utils.finalizeRuleResult(goingIn);

    expect(goingIn).toBe(comingOut);
  });

  it('assigns impact if rule.impact is defined', function () {
    axe._audit = {
      rules: [{ id: 'foo', impact: 'critical' }]
    };

    var output = axe.utils.finalizeRuleResult({
      id: 'foo',
      nodes: [
        {
          any: [
            {
              result: false,
              impact: 'minor'
            }
          ],
          all: [],
          none: []
        }
      ]
    });

    expect(output.impact).toBe('critical');
    expect(output.violations[0].impact).toBe('critical');
    expect(output.violations[0].any[0].impact).toBe('critical');
  });

  it('leaves impact as null when rule.impact is defined', function () {
    axe._audit = {
      rules: [{ id: 'foo', impact: 'critical' }]
    };

    var output = axe.utils.finalizeRuleResult({
      id: 'foo',
      nodes: [
        {
          any: [
            {
              result: true,
              impact: 'minor'
            }
          ],
          all: [],
          none: []
        }
      ]
    });

    expect(output.impact).toBeNull();
    expect(output.passes[0].impact).toBeNull();
    expect(output.passes[0].any[0].impact).toBe('critical');
  });
});
