// FIXME(phase-3-sprint-4b): codemod blocker — unresolved axe.testUtils.* (Path-B helper migration); post-codemod failure: Error: Failed to import test file /Users/tonykornmeier/Code/axe-core/packages/axe-core/test/browser/core/public/reporter.test.ts
describe('axe.reporter', function () {
  var orig = {};
  beforeAll(function () {
    orig.reporters = window.reporters;
  });

  afterAll(function () {
    Object.keys(orig).forEach(function (k) {
      window[k] = orig[k];
    });
  });

  it('should add reporter with given name', function () {
    axe.addReporter('bob', 'joe');
    expect(axe.getReporter('bob')).toBe('joe');
  });

  it('returns false when reporter does not exist', function () {
    expect(axe.hasReporter('fancy-bob')).toBe(false);
  });

  it('returns true when reporter exists', function () {
    axe.addReporter('sponge');
    expect(axe.hasReporter('sponge')).toBe(true);
  });
});
