{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./lib",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@checks/*": ["./lib/checks/*"],
      "@commons/*": ["./lib/commons/*"],
      "@core/*": ["./lib/core/*"],
      "@standards/*": ["./lib/standards/*"],
      "@lib/*": ["./lib/*"],
      "@helpers/*": ["./test/browser/_helpers/*"]
    }
  },
  "references": [{ "path": "../schemas" }],
  "include": ["lib"],
  "exclude": ["node_modules", "dist", "test"]
}
